{
  "name": "notebook",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "preview": "npm run build && npx --yes wrangler@4.68.0 dev",
    "deploy": "npm run build && npx --yes wrangler@4.68.0 deploy",
    "db:create": "npx --yes wrangler@4.68.0 d1 create notebook",
    "db:migrate:local": "npx --yes wrangler@4.68.0 d1 migrations apply notebook --local",
    "db:migrate:remote": "npx --yes wrangler@4.68.0 d1 migrations apply notebook --remote",
    "lint": "eslint ."
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.470.0",
    "next": "15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
